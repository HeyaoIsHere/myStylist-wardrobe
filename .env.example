# Optional — matting service base URL (default: http://localhost:8001)
NEXT_PUBLIC_MATTING_URL=http://localhost:8001

# Optional — where the Python service loads models / writes overlay PNGs
# MYSTYLIST_MODELS_DIR=tools/matting/models
# MYSTYLIST_UPLOAD_DIR=public/uploads

# Optional — HuggingFace mirror for China networks (used by download-models.py)
# HF_ENDPOINT=https://hf-mirror.com

# --- Post-matting AI: metadata extraction (Independent step, Phase 1) ---
# Provider selection. mock = offline, deterministic, no keys (default).
# deepseek = hosted OpenAI-compatible endpoint behind the provider seam.
AI_PROVIDER=mock

# DeepSeek / OpenAI-compatible endpoint. Keys are SERVER-SIDE ONLY — never
# prefixed NEXT_PUBLIC, never imported from the client bundle.
# DEEPSEEK_API_KEY=
# AI_TEXT_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com

# Optional data locations (defaults live under ./data; overrides used by tests)
# MYSTYLIST_METADATA_FILE=data/metadata.json
# MYSTYLIST_LOG_DIR=data/logs
# MYSTYLIST_EMBEDDINGS_FILE=data/embeddings.json

# --- Semantic retrieval (Phase 2) ---
# Embedding provider. local = deterministic, offline, zero keys (default).
# openai = hosted OpenAI-compatible embeddings endpoint (text only, never images).
AI_EMBEDDING_PROVIDER=local

# Hosted embeddings (only needed when AI_EMBEDDING_PROVIDER=openai).
# Use a MULTILINGUAL model (the app is en/zh), e.g. text-embedding-3-small or a
# Qwen/BGE endpoint. Keys are SERVER-SIDE ONLY.
# EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_BASE_URL=https://api.openai.com

# --- Recommendation workflow (Phase 3) ---
# POST /api/recommend reuses AI_PROVIDER / the embedding provider above — no
# extra keys. With AI_PROVIDER=mock the workflow runs fully offline.
# Token usage (when reported) lands in data/logs/recommend.jsonl.

# --- Outfit validation (Phase 4) ---
# POST /api/recommend now validates every composed look before it is accepted:
# deterministic hard guards always run (zero keys); the semantic (style/colour/
# occasion/silhouette) review reuses AI_PROVIDER — with mock it is deterministic
# and offline. The semantic verdict lands in data/logs/recommend.jsonl.
